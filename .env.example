# Cookie Bounties environment (PRD §7)

# ── Cookie Chain (SVM / Solana-compatible) — use the official Cookie Chain endpoints, not Solana ──
NEXT_PUBLIC_COOKIE_RPC_URL=
NEXT_PUBLIC_COOKIE_WS_URL=
NEXT_PUBLIC_COOKIE_EXPLORER_URL=

# The deployed Cookie Bounties program id (from `anchor deploy` / `anchor keys sync`).
NEXT_PUBLIC_BOUNTIES_PROGRAM_ID=

# ── Neon PostgreSQL (application/indexing database — never the authority over funds) ──
# The app builds and runs without it; the marketplace then falls back to the in-repo seed.
DATABASE_URL=

# ── App ──
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only secrets must NOT use the NEXT_PUBLIC_ prefix. Never commit real values.
